TELEGRAM_BOT_TOKEN=replace_with_botfather_token
OZON_CLIENT_ID=replace_with_ozon_client_id
OZON_API_KEY=replace_with_ozon_api_key

# ID Telegram-группы, участникам которой разрешён доступ к боту.
ALLOWED_TELEGRAM_GROUP_ID=-1000000000000

# Для серверного webhook-режима. WEBHOOK_BASE_URL можно не задавать на Railway:
# адрес будет собран из переменной RAILWAY_PUBLIC_DOMAIN.
WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret

# Необязательно
DATABASE_PATH=data/bot.sqlite3
OZON_API_BASE_URL=https://api-seller.ozon.ru
REPORT_TIMEZONE=Europe/Moscow
